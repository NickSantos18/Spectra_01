{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spectra-web",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "spectra_link_guard.web.app:app",
        "--port",
        "8000",
        "--reload"
      ],
      "port": 8000,
      "env": {
        "SPECTRA_SEGREDO": "dev-local-nao-usar-em-producao-troque-esta-chave"
      }
    }
  ]
}
