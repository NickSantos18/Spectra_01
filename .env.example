# Chaves de API das listas publicas de reputacao. Todas sao opcionais:
# sem chave, o provedor correspondente e simplesmente ignorado.
SPECTRA_GSB_API_KEY=
SPECTRA_VT_API_KEY=
SPECTRA_PHISHTANK_APP_KEY=

# Acesso e banco
SPECTRA_BD=dados/spectra.db
SPECTRA_SEGREDO=troque-por-uma-chave-longa-e-aleatoria
SPECTRA_COOKIE_SEGURO=0

# Login com Google (opcional)
SPECTRA_GOOGLE_CLIENT_ID=
SPECTRA_GOOGLE_CLIENT_SECRET=
SPECTRA_GOOGLE_REDIRECT=http://localhost:8000/auth/google/callback

# E-mails de editores autorizados a convidar especialistas para o blog (separados por vírgula).
SPECTRA_EDITOR_EMAILS=

# Assistente com IA (opcional). Sem chave, os chats usam respostas por regra.
# Instale com: pip install -e ".[ia]"
ANTHROPIC_API_KEY=
# SPECTRA_IA_MODELO=claude-opus-5
# SPECTRA_IA=0   # desliga a IA mesmo com chave
